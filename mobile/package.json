{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "expo": "~56.0.16",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.23",
    "expo-device": "^56.0.4",
    "expo-font": "~56.0.7",
    "expo-image-picker": "~56.0.21",
    "expo-linking": "~56.0.15",
    "expo-notifications": "~56.0.21",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prestart": "node -e \"const fs=require('fs'),os=require('os');const ip=Object.values(os.networkInterfaces()).flat().find(i=>i.family==='IPv4'&&!i.internal)?.address;if(ip){const line='EXPO_PUBLIC_API_URL=http://'+ip+'/api/v1\\n';const env=fs.existsSync('.env.local')?fs.readFileSync('.env.local','utf8'):'';fs.writeFileSync('.env.local',env.replace(/^EXPO_PUBLIC_API_URL=.*$/m,line.trim())||(env+line));console.log('API URL set to http://'+ip+'/api/v1')}\"",
    "start": "expo start --dev-client",
    "android": "expo start --android --dev-client",
    "ios": "expo start --ios --dev-client",
    "build:dev": "eas build --profile development --platform android",
    "tunnel": "bash scripts/dev-tunnel.sh",
    "web": "expo start --web",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/.*|native-base|react-native-svg))"
    ]
  },
  "private": true
}
